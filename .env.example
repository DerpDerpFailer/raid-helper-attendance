# Discord bot (Discord Developer Portal > Applications > your app)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Raid-Helper premium API (server API key via the /apikey command in Discord)
RAIDHELPER_API_KEY=
RAIDHELPER_SERVER_ID=

# Sync
POLL_INTERVAL_MINUTES=20

# Stats periods: week | month | rolling
PERIOD_MODE=week
# Only used when PERIOD_MODE=rolling
PERIOD_ROLLING_DAYS=30

# Ranking eligibility: minimum tenure (days since last join) to appear in rankings
ELIGIBILITY_MIN_DAYS=14

# Number of entries shown in /top and /flop
TOP_FLOP_SIZE=10

# SQLite file location (inside the container, mounted volume)
DB_PATH=./data/bot.sqlite

LOG_LEVEL=info
